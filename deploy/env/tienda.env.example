# Plantilla de /etc/ferreteria/tienda.env (Guía 18). NO tiene secretos: se copia, se reemplaza
# cada CAMBIAR_... en la EC2 y se protege con chmod 600. El archivo real nunca va a Git.
# Sin comillas y sin espacios alrededor del "=".
SPRING_PROFILES_ACTIVE=prod

# Base y usuario propios de la tienda (deploy/sql/crear_bases.sql)
TIENDA_DB_URL=jdbc:mysql://localhost:3306/ferreteria_los_maestros
TIENDA_DB_USER=tienda_app
TIENDA_DB_PASSWORD=CAMBIAR_CLAVE_TIENDA_APP

# Debe ser EXACTAMENTE el mismo valor que en auth.env
JWT_SECRET=CAMBIAR_SECRETO_BASE64_COMPARTIDO

# Origen del frontend: la IP elástica (o el dominio) con http:// y sin barra final
APP_CORS_ALLOWED_ORIGIN=http://IP_PUBLICA
