# Plantilla de /etc/ferreteria/auth.env (Guía 18). NO tiene secretos: se copia, se reemplaza
# cada CAMBIAR_... en la EC2 y se protege con chmod 600. El archivo real nunca va a Git.
# Sin comillas y sin espacios alrededor del "=".
SPRING_PROFILES_ACTIVE=prod

# Base y usuario propios de Auth (deploy/sql/crear_bases.sql)
AUTH_DB_URL=jdbc:mysql://localhost:3306/ferreteria_auth
AUTH_DB_USER=auth_app
AUTH_DB_PASSWORD=CAMBIAR_CLAVE_AUTH_APP

# Debe ser EXACTAMENTE el mismo valor en tienda.env (openssl rand -base64 32)
JWT_SECRET=CAMBIAR_SECRETO_BASE64_COMPARTIDO

# Origen del frontend: la IP elástica (o el dominio) con http:// y sin barra final
APP_CORS_ALLOWED_ORIGIN=http://IP_PUBLICA

# Claves de los usuarios demo que crea DatosIniciales en la base nueva
# (cliente@losmaestros.cl, vendedor@losmaestros.cl, admin@losmaestros.cl)
DEMO_CLAVE_CLIENTE=CAMBIAR_CLAVE_CLIENTE
DEMO_CLAVE_VENDEDOR=CAMBIAR_CLAVE_VENDEDOR
DEMO_CLAVE_ADMIN=CAMBIAR_CLAVE_ADMIN
